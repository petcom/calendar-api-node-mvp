# Server Configuration
PORT=3000
ORIGIN_URL=http://localhost
STORAGE_DIR=/srv/calendar-api/storage

# CORS Configuration (comma-separated list of ports)
# Leave empty to use default ports (2368-2378, 3000, 8180), or override with custom ports
ALLOWED_PORTS=

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_this_to_a_secure_random_string

